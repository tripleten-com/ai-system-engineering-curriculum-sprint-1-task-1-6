# Coldline
# File: .env.example
# Component: Local port configuration
# Purpose: Show optional host-port overrides without storing secrets.
# Interacts With: compose.yaml
# Sprint/Task: Sprint 1 — Project 1
# Concepts: Configuration safety
# Tools: Docker Compose

# Optional host-port overrides. Compose defaults are 8000, 3000, 9090, and 16686.
# Never store secrets in this file.
COLDLINE_API_HOST_PORT=8000
COLDLINE_GRAFANA_HOST_PORT=3000
COLDLINE_PROMETHEUS_HOST_PORT=9090
COLDLINE_JAEGER_HOST_PORT=16686
